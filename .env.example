# ── Banco de dados (PostgreSQL) ──
DATABASE_URL="postgresql://kimono:kimono@localhost:5432/kimono_store?schema=public"

# ── Autenticação ──
# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# URL pública do site (sem barra no final). Usada em redirects do login com Google.
APP_URL="http://localhost:3000"
# Usada nas tags SEO (canonical, og:url, sitemap). Normalmente igual a APP_URL.
VITE_SITE_URL="http://localhost:3000"

# ── Login com Google (opcional) ──
# Console Google Cloud > Credenciais > ID do cliente OAuth (aplicativo da Web)
# URI de redirecionamento autorizado: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Mercado Pago (pagamento online: PIX e cartão) ──
# Painel Mercado Pago > Seu negócio > Configurações > Credenciais.
# Use o Access Token de TESTE para validar e troque pelo de PRODUÇÃO ao publicar.
# É uma senha: nunca envie por e-mail/print e nunca coloque no código.
MP_ACCESS_TOKEN=""
# Assinatura do webhook (Suas integrações > Webhooks > "Chave secreta"). Recomendado em produção.
# URL a cadastrar no painel: {APP_URL}/api/mercadopago/webhook  (evento: Pagamentos)
MP_WEBHOOK_SECRET=""
# Máximo de parcelas no cartão (1 a 12). Juros/condições são definidos na conta Mercado Pago.
MP_MAX_INSTALLMENTS="12"
# Libera boleto no checkout (padrão: só PIX e cartão)
MP_ALLOW_BOLETO="false"
# Libera "dinheiro na loja" (retirada) no checkout. Ative quando a loja física existir.
ALLOW_CASH_PICKUP="false"

# ── Seed (npm run db:seed): cria o primeiro administrador ──
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha"

# ── Seed / deploy (Easypanel) ──
# true = o container roda o seed a cada start (idempotente, não duplica). Útil no 1º deploy.
SEED_ON_START="false"
# false = só cria o catálogo (sem clientes/pedidos/boletos de demonstração). Use em produção.
SEED_DEMO="true"
# Senha dos clientes de teste (cliente@teste.com, maria@teste.com, joao@teste.com)
DEMO_PASSWORD="Teste@123"
# Domínio público usado no SEO. É lido no BUILD: defina também como build arg no Easypanel.
# (VITE_SITE_URL já aparece acima.)
