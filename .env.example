# ── Banco de dados (PostgreSQL) ──
DATABASE_URL="postgresql://kimono:kimono@localhost:5432/kimono_store?schema=public"

# ── Autenticação ──
# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# URL pública do site (sem barra no final). Usada em redirects do login com Google.
APP_URL="http://localhost:3000"
# Usada nas tags SEO (canonical, og:url, sitemap). Normalmente igual a APP_URL.
VITE_SITE_URL="http://localhost:3000"

# ── Login com Google (opcional) ──
# Console Google Cloud > Credenciais > ID do cliente OAuth (aplicativo da Web)
# URI de redirecionamento autorizado: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Mercado Pago (pagamento online: PIX e cartão) — Checkout Pro via API de Orders ──
# Crie a aplicação em mercadopago.com.br/developers com Tipo de API = "API de Orders".
# O Access Token é uma senha: nunca envie por e-mail/print e nunca coloque no código.
MP_ACCESS_TOKEN=""
# Chave secreta do webhook (Suas integrações > Webhooks > Configurar notificações). Recomendado.
# URL a cadastrar: {APP_URL}/api/mercadopago/webhook   Evento: "Order (Mercado Pago)"
MP_WEBHOOK_SECRET=""
# Máximo de parcelas no cartão (1 a 12)
MP_MAX_INSTALLMENTS="12"
# Parcelas sem juros de 2x até N (opcional, 2 a 12). Vazio = condições padrão da conta Mercado Pago.
MP_INTEREST_FREE_UP_TO=""
# Validade da cobrança (formato ISO 8601, ex.: P1D = 1 dia, P2D = 2 dias)
MP_ORDER_EXPIRATION="P1D"
# Libera boleto no checkout (padrão: só PIX e cartão)
MP_ALLOW_BOLETO="false"
# Libera "dinheiro na loja" (retirada) no checkout. Ative quando a loja física existir.
ALLOW_CASH_PICKUP="false"

# ── Seed (npm run db:seed): cria o primeiro administrador ──
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha"
